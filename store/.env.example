# Copy this file to `.env` and fill it in. NEVER commit `.env` itself.
#   cp .env.example .env

# What customers see as the shop's name.
STORE_NAME="Our Store"

# Leave blank locally to use SQLite (no setup needed).
# Railway injects the real Postgres URL automatically in production.
# DATABASE_URL=postgresql://user:pass@host:5432/store

ENVIRONMENT=development

# Money. Prices are stored as whole pence, so 499 = £4.99.
CURRENCY=GBP
CURRENCY_SYMBOL=£

# Where product photos live.
# Phase 1: "/images" — files served by this app from web/images/.
# Phase 2: your Cloudflare R2 public bucket url, e.g.
#   IMAGE_BASE_URL=https://pub-xxxxxxxx.r2.dev
IMAGE_BASE_URL=/images

# Flat shipping fee in pence. 499 = £4.99. Set 0 for free shipping.
SHIPPING_FLAT_CENTS=499
# Two-letter country codes Stripe will allow shipping to. "GB" or "GB,IE" etc.
SHIPPING_COUNTRIES=GB

# Only needed if the storefront ever moves to a different domain than the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Stripe ----------------------------------------------------------------
# Leave these blank and the shop still works — browsing is fine, and checkout
# says plainly that payments aren't switched on. It never half-works.
#
# Keep the TEST keys (sk_test_...) until you have done the security checklist
# in docs/PRD-STORE.md §6. Test mode card: 4242 4242 4242 4242.
#
# The webhook secret comes from `stripe listen` locally, or from the webhook
# endpoint you create in the Stripe dashboard for a deployed site.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where Stripe sends customers back to after paying. On Railway this must be
# your real public url, otherwise customers land on localhost and see nothing.
PUBLIC_BASE_URL=http://localhost:8000
